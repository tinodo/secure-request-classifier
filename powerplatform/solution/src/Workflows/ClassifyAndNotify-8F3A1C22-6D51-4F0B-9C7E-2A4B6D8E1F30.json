          "inputs": {
            "requesterName": "@triggerBody()['requesterName']",
            "requesterEmail": "@triggerBody()['requesterEmail']",
            "title": "@triggerBody()['requestTitle']",
            "category": "@triggerBody()['category']",
            "impact": "@triggerBody()['impact']",
            "description": "@triggerBody()['description']",
            "correlationId": "@variables('correlationId')"
          }
        },
        "Invoke_classification_API": {
          "runAfter": {
            "Compose_request_payload": [
