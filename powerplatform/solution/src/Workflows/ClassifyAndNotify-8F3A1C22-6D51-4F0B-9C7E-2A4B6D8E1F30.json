          "inputs": {
            "host": {
              "connectionName": "shared_webcontents",
              "operationId": "InvokeHttp",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents"
            },
            "parameters": {
              "request/method": "POST",
              "request/url": "@{parameters('srcls_FunctionBaseUrl (srcls_FunctionBaseUrl)')}@{parameters('srcls_FunctionClassifyPath (srcls_FunctionClassifyPath)')}",
              "request/headers": {
                "Content-Type": "application/json",
                "Accept": "application/json",
                "x-correlation-id": "@variables('correlationId')"
              },
              "request/body": "@{string(outputs('Compose_request_payload'))}"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Parse_classification_response": {
          "runAfter": {
            "Invoke_classification_API": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "4fbc50a3-8e74-4c16-d9a5-3cae2f6b8d4b"
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@body('Invoke_classification_API')",
            "schema": {
              "type": "object",
              "properties": {
                "requestId": { "type": "string" },
                "status": { "type": "string" },
                "priority": { "type": "string" },
                "priorityRank": { "type": "integer" },
                "assignedTeam": { "type": "string" },
                "normalizedCategory": { "type": "string" },
                "normalizedImpact": { "type": "string" },
                "targetResponseDate": { "type": "string" },
                "slaBusinessHours": { "type": "integer" },
                "receivedAtUtc": { "type": "string" },
                "requesterName": { "type": "string" },
                "requesterEmail": { "type": "string" },
                "title": { "type": "string" },
                "classificationReason": { "type": "string" },
                "notes": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "correlationId": { "type": "string" }
              }
            }
          }
        },
