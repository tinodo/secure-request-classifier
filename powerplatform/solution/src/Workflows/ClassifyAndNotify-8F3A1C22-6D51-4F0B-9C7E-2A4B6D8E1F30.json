          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@body('Parse_classification_response')?['requesterEmail']",
              "emailMessage/Subject": "@{body('Parse_classification_response')?['requestId']} - @{body('Parse_classification_response')?['priority']} - @{body('Parse_classification_response')?['title']}",
              "emailMessage/Body": "<p>Hello @{body('Parse_classification_response')?['requesterName']},</p><p>Your request has been received and classified.</p><table border=\"0\" cellpadding=\"6\"><tr><td><strong>Request ID</strong></td><td>@{body('Parse_classification_response')?['requestId']}</td></tr><tr><td><strong>Priority</strong></td><td>@{body('Parse_classification_response')?['priority']}</td></tr><tr><td><strong>Assigned team</strong></td><td>@{body('Parse_classification_response')?['assignedTeam']}</td></tr><tr><td><strong>Category</strong></td><td>@{body('Parse_classification_response')?['normalizedCategory']}</td></tr><tr><td><strong>Impact</strong></td><td>@{body('Parse_classification_response')?['normalizedImpact']}</td></tr><tr><td><strong>Response target</strong></td><td>@{body('Parse_classification_response')?['targetResponseDate']} UTC</td></tr></table><p>@{body('Parse_classification_response')?['classificationReason']}</p><p style=\"color:#666;font-size:12px\">Classified by the Secure Request Classifier (@{parameters('srcls_EnvironmentLabel (srcls_EnvironmentLabel)')}). The classification service has no public endpoint; this request was processed over private networking. Correlation ID @{body('Parse_classification_response')?['correlationId']}.</p>",
              "emailMessage/Importance": "Normal"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Respond_to_the_app": {
          "runAfter": {
            "Send_confirmation_email": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "61de72c5-a096-4e38-fb27-5ec0417daf6d"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "requestId": "@body('Parse_classification_response')?['requestId']",
              "status": "@body('Parse_classification_response')?['status']",
              "priority": "@body('Parse_classification_response')?['priority']",
              "assignedTeam": "@body('Parse_classification_response')?['assignedTeam']",
              "normalizedCategory": "@body('Parse_classification_response')?['normalizedCategory']",
              "targetResponseDate": "@body('Parse_classification_response')?['targetResponseDate']",
              "classificationReason": "@body('Parse_classification_response')?['classificationReason']",
              "correlationId": "@body('Parse_classification_response')?['correlationId']"
            },
            "schema": {
              "type": "object",
              "properties": {
                "requestId": { "title": "requestId", "x-ms-dynamically-added": true, "type": "string" },
                "status": { "title": "status", "x-ms-dynamically-added": true, "type": "string" },
                "priority": { "title": "priority", "x-ms-dynamically-added": true, "type": "string" },
                "assignedTeam": { "title": "assignedTeam", "x-ms-dynamically-added": true, "type": "string" },
                "normalizedCategory": { "title": "normalizedCategory", "x-ms-dynamically-added": true, "type": "string" },
                "targetResponseDate": { "title": "targetResponseDate", "x-ms-dynamically-added": true, "type": "string" },
                "classificationReason": { "title": "classificationReason", "x-ms-dynamically-added": true, "type": "string" },
                "correlationId": { "title": "correlationId", "x-ms-dynamically-added": true, "type": "string" }
              }
            }
          }
        },
        "Respond_when_the_notification_fails": {
          "runAfter": {
            "Send_confirmation_email": [
              "Failed",
              "TimedOut",
              "Skipped"
            ]
          },
          "metadata": {
            "operationMetadataId": "9a4c1e07-3b58-4d6f-8e21-7c0f5b93a6d4"
          },
          "type": "Response",
          "kind": "PowerApp",
          "description": "The classification is the business outcome; the email is a side effect. Without this branch a request that was classified successfully but could not be emailed returned nothing at all, and the run failed opaquely.",
          "inputs": {
            "statusCode": 200,
            "body": {
              "requestId": "@body('Parse_classification_response')?['requestId']",
              "status": "@body('Parse_classification_response')?['status']",
              "priority": "@body('Parse_classification_response')?['priority']",
              "assignedTeam": "@body('Parse_classification_response')?['assignedTeam']",
              "normalizedCategory": "@body('Parse_classification_response')?['normalizedCategory']",
              "targetResponseDate": "@body('Parse_classification_response')?['targetResponseDate']",
              "classificationReason": "@{concat(body('Parse_classification_response')?['classificationReason'], ' The confirmation email could not be sent, so the requester has not been notified. The classification itself succeeded.')}",
              "correlationId": "@body('Parse_classification_response')?['correlationId']"
            },
            "schema": {
              "type": "object",
              "properties": {
                "requestId": { "title": "requestId", "x-ms-dynamically-added": true, "type": "string" },
                "status": { "title": "status", "x-ms-dynamically-added": true, "type": "string" },
                "priority": { "title": "priority", "x-ms-dynamically-added": true, "type": "string" },
                "assignedTeam": { "title": "assignedTeam", "x-ms-dynamically-added": true, "type": "string" },
                "normalizedCategory": { "title": "normalizedCategory", "x-ms-dynamically-added": true, "type": "string" },
                "targetResponseDate": { "title": "targetResponseDate", "x-ms-dynamically-added": true, "type": "string" },
                "classificationReason": { "title": "classificationReason", "x-ms-dynamically-added": true, "type": "string" },
                "correlationId": { "title": "correlationId", "x-ms-dynamically-added": true, "type": "string" }
              }
            }
          }
        },
        "Respond_with_the_failure": {
          "runAfter": {
            "Invoke_classification_API": [
              "Failed",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "72ef83d6-b1a7-4f49-0c38-6fd15284b07e"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": "@{if(greater(coalesce(outputs('Invoke_classification_API')?['statusCode'], 0), 0), outputs('Invoke_classification_API')?['statusCode'], 502)}",
            "body": {
              "requestId": "",
              "status": "Failed",
              "priority": "",
              "assignedTeam": "",
              "normalizedCategory": "",
              "targetResponseDate": "",
              "classificationReason": "@{concat(coalesce(body('Invoke_classification_API')?['title'], 'The classification service could not be reached'), '. ', coalesce(body('Invoke_classification_API')?['detail'], 'Nothing answered on the private endpoint. Check that the Power Platform environment is linked to the virtual network enterprise policy and that the host name resolves to a private address.'), ' Correlation ID ', variables('correlationId'), '.')}",
              "correlationId": "@variables('correlationId')"
            },
            "schema": {
              "type": "object",
              "properties": {
                "requestId": { "title": "requestId", "x-ms-dynamically-added": true, "type": "string" },
                "status": { "title": "status", "x-ms-dynamically-added": true, "type": "string" },
                "priority": { "title": "priority", "x-ms-dynamically-added": true, "type": "string" },
                "assignedTeam": { "title": "assignedTeam", "x-ms-dynamically-added": true, "type": "string" },
                "normalizedCategory": { "title": "normalizedCategory", "x-ms-dynamically-added": true, "type": "string" },
                "targetResponseDate": { "title": "targetResponseDate", "x-ms-dynamically-added": true, "type": "string" },
                "classificationReason": { "title": "classificationReason", "x-ms-dynamically-added": true, "type": "string" },
                "correlationId": { "title": "correlationId", "x-ms-dynamically-added": true, "type": "string" }
              }
            }
          }
        }
      },
      "outputs": {}
    }
  },
  "schemaVersion": "1.0.0.0"
}
