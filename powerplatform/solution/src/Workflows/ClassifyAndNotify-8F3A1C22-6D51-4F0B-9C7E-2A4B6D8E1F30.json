          "metadata": {
            "operationMetadataId": "6f1b0e55-4a7c-4f2e-bd91-9c0e3a71d482"
          },
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "requesterName": {
                  "title": "Requester name",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Full name of the person raising the request",
                  "x-ms-content-hint": "TEXT"
                },
                "requesterEmail": {
                  "title": "Requester email",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Mailbox that receives the confirmation",
                  "x-ms-content-hint": "EMAIL"
                },
                "requestTitle": {
                  "title": "Request title",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Short summary of the request",
                  "x-ms-content-hint": "TEXT"
                },
                "category": {
                  "title": "Category",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "IT, Facilities, HR or Other",
                  "x-ms-content-hint": "TEXT"
                },
                "impact": {
                  "title": "Impact",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Low, Medium or High",
                  "x-ms-content-hint": "TEXT"
                },
                "description": {
                  "title": "Description",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Free-text detail",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "requesterName",
                "requesterEmail",
                "requestTitle",
                "category",
                "impact"
              ]
            }
          }
        }
